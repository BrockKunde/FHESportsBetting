# Network RPC URLs
# Get your Infura/Alchemy project ID from:
# Infura: https://infura.io
# Alchemy: https://alchemy.com

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Alternative RPC providers:
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Private Key
# IMPORTANT: Never commit your real private key!
# Get from Metamask: Account Details > Export Private Key
# Remove the 0x prefix when adding here
PRIVATE_KEY=your_private_key_without_0x_prefix

# Etherscan API Key
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# Gas Reporting (optional)
# Set to 'true' to enable gas reporting in tests
REPORT_GAS=false

# CoinMarketCap API Key (optional)
# Required for USD gas cost estimation
# Get from: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Security Configuration
# =====================

# Pauser Configuration
# Address authorized to pause/unpause the contract in emergencies
# Leave empty to use deployer address as default pauser
PAUSER_ADDRESS=

# Emergency Contacts
# Email for security notifications
SECURITY_CONTACT_EMAIL=security@example.com

# Rate Limiting
# Cooldown period (in seconds) between actions for DoS protection
ACTION_COOLDOWN=60

# Contract Pause State
# Set to 'true' to deploy contract in paused state (recommended for mainnet)
DEPLOY_PAUSED=false

# Performance & Optimization
# ==========================

# Compiler Optimization
# Number of runs for Solidity optimizer (higher = more gas efficient but larger bytecode)
OPTIMIZER_RUNS=200

# Enable via IR compilation for better optimization
OPTIMIZER_VIA_IR=true

# Gas Price Configuration (optional)
# Maximum gas price willing to pay (in gwei)
MAX_GAS_PRICE=100

# Priority fee for transactions (in gwei)
MAX_PRIORITY_FEE=2

# Transaction Configuration
# =========================

# Confirmation blocks to wait before considering transaction final
CONFIRMATION_BLOCKS=2

# Transaction timeout (in milliseconds)
TRANSACTION_TIMEOUT=120000

# Retry attempts for failed transactions
MAX_RETRY_ATTEMPTS=3

# Monitoring & Alerts
# ===================

# Enable transaction monitoring
ENABLE_MONITORING=false

# Webhook URL for alerts (optional)
ALERT_WEBHOOK_URL=

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=

# Discord webhook for notifications (optional)
DISCORD_WEBHOOK_URL=

# Testing Configuration
# =====================

# Enable verbose test output
TEST_VERBOSE=false

# Network for integration tests
TEST_NETWORK=hardhat

# Fork testing (set to 'true' to test against mainnet fork)
FORK_TESTING=false

# Fork block number (leave empty for latest)
FORK_BLOCK_NUMBER=

# Development Settings
# ====================

# Enable debug mode
DEBUG=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable stack traces for errors
ENABLE_STACK_TRACES=true
