#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run linting
echo "📝 Checking code quality..."
npm run lint:sol || exit 1
npm run lint:js || exit 1

# Run prettier check
echo "✨ Checking code formatting..."
npm run prettier:check || exit 1

# Run tests
echo "🧪 Running tests..."
npm test || exit 1

# Check for sensitive data
echo "🔒 Checking for sensitive data..."
if git diff --cached --name-only | xargs grep -i "private.*key.*=\|secret.*=\|password.*=" 2>/dev/null; then
  echo "❌ Found potential secrets in staged files!"
  echo "Please remove sensitive data before committing"
  exit 1
fi

echo "✅ All pre-commit checks passed!"
